// module/ship/console_api.def -- the ship's API, as one place a program can read.
//
// The command surface Svcmd_Ship_f (module/ship/g_ship.cpp) answers: the verb, the arguments
// it takes, and the station that owns it where a station does. This is the enumerated set the
// ship's computer may answer from; an input outside it is refused in character, never invented.
//
// It is included (X-macro) by module/ship/ship_core.cpp to build the runtime table, so the
// module and this file cannot disagree; tools/console/verbs.py parses it and scripts/api-check.sh
// fails when it drifts from Svcmd_Ship_f in either direction (docs/evidence/the-computer-api.md).
//
//   CONSOLE_VERB(verb, args, stations)
//     args     -- a terse usage hint; '-' when it takes none
//     stations -- 'any' (any console), '-' (developer console only, no station gate), or one
//                 or more pipe-separated canonical StationName tokens (engineering, tactical,
//                 conn, ops, sickbay)

CONSOLE_VERB("accept", "-", "engineering")
CONSOLE_VERB("acquire", "mine|trade|salvage|research", "-")
CONSOLE_VERB("advance", "<deck>", "-")
CONSOLE_VERB("airponics", "[on|off]", "-")
CONSOLE_VERB("alert", "green|yellow|red", "engineering|tactical")
CONSOLE_VERB("alloc", "<system> <percent>", "any")
CONSOLE_VERB("auto", "[on|off]", "engineering")
CONSOLE_VERB("awareness", "-", "-")
