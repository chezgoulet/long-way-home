 	ri.Hunk_FreeTempMemory( upload_data.buffer );
 }
 
+// Long Way Home: overwrite a named shader's base image with live RGBA. The image must already exist
+// at this size -- the shader's own placeholder -- and this only refreshes its contents, so a world
+// surface (a panel) can show state the game recomputes each frame (see refexport_t).
+void RE_UpdatePanelImage( const char *shaderName, const byte *rgba, int width, int height ) {
+	shader_t *sh;
+	image_t *image;
+	int w, h;
+	if ( !shaderName || !rgba || width <= 0 || height <= 0 ) return;
+	sh = R_FindShaderByName( shaderName );
+	if ( !sh || sh == tr.defaultShader || !sh->stages[0] ) return;
+	image = sh->stages[0]->bundle[0].image[0];
+	if ( !image || image->uploadWidth <= 0 || image->uploadHeight <= 0 ) return;
+	R_SyncRenderThread();
+	// The image's own size is authority: the shader may have scaled or picmip'd it. Resample to it.
+	w = image->uploadWidth;
+	h = image->uploadHeight;
+	if ( w == width && h == height ) {
+		vk_upload_image_data( image, 0, 0, w, h, 1, (byte *)rgba, w * h * 4, qtrue );
+	} else {
+		byte *resampled = (byte *)ri.Hunk_AllocateTempMemory( w * h * 4 );
+		ResampleTexture( (unsigned *)rgba, width, height, (unsigned *)resampled, w, h );
+		vk_upload_image_data( image, 0, 0, w, h, 1, resampled, w * h * 4, qtrue );
+		ri.Hunk_FreeTempMemory( resampled );
+	}
+}
+
 #else // !USE_VULKAN
 
 static GLint RawImage_GetInternalFormat( const byte *scan, int numPixels, qboolean lightMap, qboolean allowCompression )
@@ -1056,6 +1082,18 @@
 		Upload32( data, x, y, width, height, image, qtrue ); // subImage = qtrue
 	}
 }
+
+// Long Way Home: overwrite a named shader's base image with live RGBA (GL path; see the Vulkan one).
+void RE_UpdatePanelImage( const char *shaderName, const byte *rgba, int width, int height ) {
+	shader_t *sh;
+	image_t *image;
+	if ( !shaderName || !rgba || width <= 0 || height <= 0 ) return;
+	sh = R_FindShaderByName( shaderName );
+	if ( !sh || sh == tr.defaultShader || !sh->stages[0] ) return;
+	image = sh->stages[0]->bundle[0].image[0];
+	if ( !image || image->uploadWidth != width || image->uploadHeight != height ) return;
+	R_UploadSubImage( (byte *)rgba, 0, 0, width, height, image );
+}
 #endif // !USE_VULKAN
 
 
