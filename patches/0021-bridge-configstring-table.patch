-#define CS_MAX 1024
-static char g_configstrings[CS_MAX][1024];
+// The configstring table the bridge keeps on the game's behalf, hands to the cgame in the gamestate,
+// and persists in a save. It was a literal 1024 -- the wrong 1024: MAX_CONFIGSTRINGS (what the
+// gamestate and the save format are sized against) is 4096, and the game's own layout bound is
+// CS_PLAYERS + MAX_CLIENTS. Anything numbered above the literal was dropped with no word, so content
+// that exceeded the table would disappear and be blamed on the content. Derived from MAX_CONFIGSTRINGS
+// now: the table can never again disagree with the ceiling, and it holds any configstring the game's
+// layout is allowed to name (bg_public.h errors out on a layout above MAX_CONFIGSTRINGS). Renamed
+// from CS_MAX because bg_public.h, included above, already defines CS_MAX (the game's own layout
+// bound) -- the redefinition was silent under the build's -w. See docs/evidence/the-bridge-traps.md.
+#define SP_CS_MAX MAX_CONFIGSTRINGS
+static char g_configstrings[SP_CS_MAX][1024];
 
