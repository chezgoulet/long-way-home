From: Long Way Home <noreply@long-way-home.invalid>
Subject: [PATCH 5/10] attach points for Long Way Home's own game logic

Twenty-one one-line calls and a build option. The logic itself is not in this tree: it is compiled
in from LWH_MODULE_DIR (the long-way-home repository's module/), and game/lwh_hooks.h and
ui/lwh_ui_hooks.h turn every call into an empty inline when that is unset, so this patch alone
changes no behaviour.

Four things attach here: the crew direction layer (Crew_*), the ship simulation (Ship_*),
deck-scoped names for scripts on the merged ship (LWH_Scope*), and our screens in the UI module
(LWH_UI_ConsoleCommand; sources under LWH_MODULE_DIR/ui go to the UI library, the rest to the game):
  G_InitCvars / InitGame       register cvars; start once the map's entities exist
  G_RunFrame (first, last)     the frame clock, then each system's turn after every entity has thought
  ShutdownGame                 the ship's state is carried through a level change
  NPC_Use / NPC_Respond        time the player's address against the acknowledgement
  NPC_Touch                    being walked into
  G_LoadSave_*MiscData         one optional save chunk each, written only while the system is on
  ConsoleCommand (game, ui)    the "crew" and "ship" commands; our screens' commands
  CTaskManager::Update, G_Find while a script runs, a name is looked up on its owner's deck first
---
diff --git a/efgame/CMakeLists.txt b/efgame/CMakeLists.txt
--- a/efgame/CMakeLists.txt
+++ b/efgame/CMakeLists.txt
@@ -82,8 +82,25 @@
 list(REMOVE_ITEM EFGAME_SRC
   ${SRC}/icarus/Interface.cpp ${SRC}/icarus/Interpreter.cpp ${SRC}/icarus/Tokenizer.cpp)
 
+# Long Way Home: game logic that is ours lives outside this tree and is compiled in from
+# LWH_MODULE_DIR (the long-way-home repository's module/). Unset, the hooks in game/lwh_hooks.h
+# are no-ops and this builds exactly as upstream does.
+set(LWH_MODULE_DIR "" CACHE PATH "Directory of additional game-module sources")
+if(LWH_MODULE_DIR)
+  file(GLOB_RECURSE LWH_MODULE_SRC ${LWH_MODULE_DIR}/*.cpp)
+  file(GLOB LWH_UI_SRC ${LWH_MODULE_DIR}/ui/*.cpp)   # screens: these belong to the UI module
+  if(LWH_UI_SRC)
+    list(REMOVE_ITEM LWH_MODULE_SRC ${LWH_UI_SRC})
+  endif()
+  list(APPEND EFGAME_SRC ${LWH_MODULE_SRC})
+endif()
+
 add_library(efgame SHARED ${EFGAME_SRC})
 target_include_directories(efgame PRIVATE ${EF_INCLUDES})
+if(LWH_MODULE_DIR)
+  target_include_directories(efgame PRIVATE ${LWH_MODULE_DIR}/crew ${LWH_MODULE_DIR}/ship)
+  target_compile_definitions(efgame PRIVATE LWH_CREW)
+endif()
 target_compile_options(efgame PRIVATE ${EF_COPTS})
 target_compile_definitions(efgame PRIVATE NDEBUG)
 target_link_options(efgame PRIVATE
@@ -103,8 +120,12 @@
 # Under _USRDLL the FX_*Think func-table (the #else / #ifndef _USRDLL branch) is excluded ->
 # zero cgame deps; the only symbol it then needs is gameinfo's `gi` (see gameinfo.cpp guard).
 list(APPEND EFUI_SRC ${SRC}/game/g_weaponLoad.cpp)
-add_library(efui SHARED ${EFUI_SRC} ${EF_SHARED_SRC} ${EFUI_EXTRA_SRC})
+add_library(efui SHARED ${EFUI_SRC} ${EF_SHARED_SRC} ${EFUI_EXTRA_SRC} ${LWH_UI_SRC})
 target_include_directories(efui PRIVATE ${EF_INCLUDES})
+if(LWH_UI_SRC)
+  target_include_directories(efui PRIVATE ${LWH_MODULE_DIR}/ui)
+  target_compile_definitions(efui PRIVATE LWH_UI)
+endif()
 target_compile_options(efui PRIVATE ${EF_COPTS})
 # _USRDLL must be target-wide (not per-file) so the globbed gameinfo.cpp also takes the UI branch.
 # Do NOT add _USRDLL to the efgame target (the game build keeps g_weaponLoad's cgame funcs[] table).
