diff --git a/efgame/src/game/lwh_hooks.h b/efgame/src/game/lwh_hooks.h
new file mode 100644
--- /dev/null
+++ b/efgame/src/game/lwh_hooks.h
@@ -0,0 +1,38 @@
+// lwh_hooks.h -- where Long Way Home's own game logic attaches to the game module.
+//
+// The logic itself is not in this tree: it is compiled in when the build sets LWH_MODULE_DIR
+// (which defines LWH_CREW). Without it every hook below is an empty inline, so the module
+// builds and behaves as it always has.
+
+#ifndef LWH_HOOKS_H
+#define LWH_HOOKS_H
+
+#ifdef LWH_CREW
+#include "g_crew.h"
+#include "g_ship.h"
+#include "g_scope.h"
+#else
+struct gentity_s;
+inline void Crew_RegisterCvars( void ) {}
+inline void Crew_Init( void ) {}
+inline void Crew_FrameBegin( void ) {}
+inline void Crew_Frame( void ) {}
+inline void Crew_OnUsed( struct gentity_s *, struct gentity_s * ) {}
+inline void Crew_OnResponded( struct gentity_s * ) {}
+inline void Crew_OnTouched( struct gentity_s *, struct gentity_s * ) {}
+inline void Crew_WriteSave( void ) {}
+inline void Crew_ReadSave( void ) {}
+inline void Svcmd_Crew_f( void ) {}
+inline void Ship_RegisterCvars( void ) {}
+inline void Ship_Init( void ) {}
+inline void Ship_Frame( void ) {}
+inline void Ship_Shutdown( void ) {}
+inline void Ship_WriteSave( void ) {}
+inline void Ship_ReadSave( void ) {}
+inline void Svcmd_Ship_f( void ) {}
+inline void LWH_ScopeBegin( int ) {}
+inline void LWH_ScopeEnd( void ) {}
+inline const char *LWH_ScopedName( const char *name ) { return name; }
+#endif
+
+#endif
diff --git a/efgame/src/ui/lwh_ui_hooks.h b/efgame/src/ui/lwh_ui_hooks.h
new file mode 100644
--- /dev/null
+++ b/efgame/src/ui/lwh_ui_hooks.h
@@ -0,0 +1,15 @@
+// lwh_ui_hooks.h -- where Long Way Home's own screens attach to the UI module.
+//
+// Like game/lwh_hooks.h: the screens are compiled in from LWH_MODULE_DIR/ui when the build sets
+// it (which defines LWH_UI). Without it this is an empty inline and the UI is upstream's.
+
+#ifndef LWH_UI_HOOKS_H
+#define LWH_UI_HOOKS_H
+
+#ifdef LWH_UI
+#include "lwh_ui.h"
+#else
+inline qboolean LWH_UI_ConsoleCommand( const char * ) { return qfalse; }
+#endif
+
+#endif
